SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# OnlineRadioBox station slug, e.g. "pingclass" for Pinguin Classics
STATION_SLUG=pingclass

# Name of the Spotify playlist to create/update
PLAYLIST_NAME=Penguin Classics

# Path to the SQLite database file. Point this at a Synology share
# (e.g. a mounted SMB/NFS volume) so history persists across runs.
DB_PATH=data/radioscrobbler.db
